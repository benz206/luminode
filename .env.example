# Copy to .env and fill in your values.
# Place .env alongside the leds binary (e.g. /usr/local/bin/.env or /etc/leds/.env).
# Alternatively, export these as systemd environment variables.

# URL of the luminode-sync beatmap service.
LUMINODE_URL=

# Path to the Spotify OAuth token file saved by:
#   beatmap-cli auth --client-id <your-client-id>
SPOTIFY_TOKEN_FILE=/home/pi/.local/share/luminode-sync/spotify_token.json

# Spotify app client ID (from developer.spotify.com).
# Only needed if the token file doesn't already embed it.
SPOTIFY_CLIENT_ID=
