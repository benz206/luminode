  (text "WS2812B LEVEL SHIFTER - Raspberry Pi GPIO18 (3.3V) to 5V DATA"
    (at 148.59 36.83 0)
    (effects
      (font
        (size 3.5 3.5)))
    (uuid "e5ddfa99-7c22-4c74-b3b2-1337a02e3d42"))

  (text "SN74AHCT1G125 buffer running at VCC=5V. Its VIH(min) is 2.0V, so 3.3V GPIO logic drives it reliably."
    (at 148.59 44.45 0)
    (effects
      (font
        (size 1.8 1.8)))
    (uuid "ea19c6c3-6f8d-4788-b77f-6ffa841f4660"))

  (text "*** EXTERNAL 5V (J2) IS NOT CONNECTED TO THE RASPBERRY Pi 5V HEADER ***"
    (at 148.59 148.59 0)
    (effects
      (font
        (size 2.4 2.4)))
    (uuid "9935ada3-add5-4f33-ab4a-eafdd113c630"))

  (text "J1 carries GPIO18 and GND only. GND is common between the Pi and the external supply - this is the required"
    (at 148.59 156.21 0)
    (effects
      (font
        (size 1.8 1.8)))
    (uuid "7c58010c-0f81-469d-8def-15042272f107"))

  (text "signal return path and does not backfeed the Pi. Power this board and the LED strip from the external supply only."
    (at 148.59 160.02 0)
    (effects
      (font
        (size 1.8 1.8)))
    (uuid "6c66d674-6232-4642-b490-7142d054d68b"))

  (text "R1 holds GPIO18 low while the Pi is off or the pin is tri-stated.   R2 damps ringing - keep close to U1 pin 4.   C1 within 3mm of U1 pin 5."
    (at 148.59 166.37 0)
    (effects
      (font
        (size 1.8 1.8)))
    (uuid "db7d97f7-632e-476c-b86e-95cd874a12f5"))

  (text "OE tied low = always enabled"
    (at 170.18 66.04 0)
    (effects
      (font
        (size 1.5 1.5)))
    (uuid "474837b8-30af-4097-901f-3af30a729b05"))

